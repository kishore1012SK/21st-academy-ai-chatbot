# --- App ---
ENV=development

# --- Database ---
# Dev (default): SQLite, no setup needed.
# Prod: swap to Postgres, nothing else in the code changes.
# DATABASE_URL=postgresql://user:password@localhost:5432/academy_chatbot

# --- Ollama ---
# Points at localhost during development. Change this single value to move
# to your own Linux server later (e.g. http://10.0.0.5:11434) — the
# frontend never needs to know.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_TIMEOUT=60
OLLAMA_MAX_RETRIES=2

# --- Auth ---
# Generate a strong secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRE_MINUTES=720
ADMIN_EMAIL=admin@21stacademy.in
ADMIN_PASSWORD=ChangeMe123!

# --- CORS ---
# Comma-separated list of every origin the widget is embedded on.
ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,https://21stacademy.in,https://www.21stacademy.in

# --- Rate limits ---
RATE_LIMIT_CHAT=20/minute
RATE_LIMIT_UPLOAD=5/minute
RATE_LIMIT_LOGIN=10/minute

# --- Uploads / RAG ---
MAX_UPLOAD_MB=20
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RAG_TOP_K=4
